<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="?actionBarSize"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/slim_margin"
        android:alpha=".9"
        app:cardBackgroundColor="@color/backgroundDefaultColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/default_margin">

                <TextView
                    android:id="@+id/tv_label_games_played"
                    style="@style/TextViewStatistics.PrimaryTextColor.Bold"
                    android:layout_marginTop="@dimen/default_margin"
                    android:text="@string/games_played"
                    app:layout_constraintEnd_toStartOf="@+id/tv_data_games_played"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_data_games_played"
                    style="@style/TextViewStatistics.PrimaryTextColor"
                    android:layout_marginStart="@dimen/default_margin"
                    android:layout_marginTop="@dimen/default_margin"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_label_games_played"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="18" />

                <TextView
                    android:id="@+id/tv_label_highest_score"
                    style="@style/TextViewStatistics.SecondaryTextColor.Bold"
                    android:layout_marginTop="@dimen/double_margin"
                    android:text="@string/highest_score"
                    app:layout_constraintEnd_toStartOf="@+id/tv_data_highest_score"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_label_games_played" />

                <TextView
                    android:id="@+id/tv_data_highest_score"
                    style="@style/TextViewStatistics.SecondaryTextColor"
                    android:layout_marginStart="@dimen/default_margin"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_label_highest_score"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_label_highest_score"
                    app:layout_constraintTop_toTopOf="@+id/tv_label_highest_score"
                    tools:text="42" />

                <TextView
                    android:id="@+id/tv_label_lowest_score"
                    style="@style/TextViewStatistics.SecondaryTextColor.Bold"
                    android:layout_marginTop="@dimen/default_margin"
                    android:text="@string/lowest_score"
                    app:layout_constraintEnd_toStartOf="@+id/tv_data_lowest_score"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_label_highest_score" />

                <TextView
                    android:id="@+id/tv_data_lowest_score"
                    style="@style/TextViewStatistics.SecondaryTextColor"
                    android:layout_marginStart="@dimen/default_margin"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_label_lowest_score"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_label_lowest_score"
                    app:layout_constraintTop_toTopOf="@+id/tv_label_lowest_score"
                    tools:text="2" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>